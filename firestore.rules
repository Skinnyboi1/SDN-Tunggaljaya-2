rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // School Profile (Public Read, Authenticated Operator Write)
    match /profile/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Teachers & Staff (Public Read, Authenticated Operator Write)
    match /teachers/{teacherId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Facilities (Public Read, Authenticated Operator Write)
    match /facilities/{facilityId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Posts, News & Announcements (Public Read, Authenticated Operator Write)
    match /posts/{postId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Gallery (Public Read, Authenticated Operator Write)
    match /gallery/{galleryId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
